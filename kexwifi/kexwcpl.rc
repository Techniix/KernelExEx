#include <windows.h>
#include "resource.h"
#include "version.h"

IDI_WIFI ICON "kexwifi.ico"

STRINGTABLE
BEGIN
    1 "Wi-Fi"
    2 "Connect to Wi-Fi networks and manage saved networks."
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "KernelExEx"
            VALUE "FileDescription", "KernelExEx Wi-Fi Control Panel"
            VALUE "FileVersion", KEXEX_VERSION_STR
            VALUE "ProductName", "KernelExEx"
            VALUE "ProductVersion", KEXEX_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
