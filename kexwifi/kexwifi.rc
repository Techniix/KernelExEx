/* KernelExEx - kexwifi.exe resources. GPLv2. */
#include <windows.h>
#include <commctrl.h>
#include "resource.h"
#include "version.h"

IDI_WIFI ICON "kexwifi.ico"

IDD_MAIN DIALOGEX 0, 0, 300, 236
STYLE DS_MODALFRAME | DS_CENTER | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
EXSTYLE WS_EX_APPWINDOW
CAPTION "Wi-Fi"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "&Adapter:", -1, 7, 9, 32, 8
    COMBOBOX        IDC_ADAPTER, 42, 7, 251, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_STATUS, 7, 25, 286, 18
    LTEXT           "&Networks in range:", -1, 7, 46, 100, 8
    CONTROL         "", IDC_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 7, 57, 222, 128
    DEFPUSHBUTTON   "&Connect", IDC_CONNECT, 236, 57, 57, 14
    PUSHBUTTON      "&Disconnect", IDC_DISCONNECT, 236, 75, 57, 14
    PUSHBUTTON      "&Forget", IDC_FORGET, 236, 93, 57, 14
    PUSHBUTTON      "&Refresh", IDC_REFRESH, 236, 111, 57, 14
    PUSHBUTTON      "&Other network...", IDC_ADDNET, 236, 129, 57, 14
    LTEXT           "", IDC_NOTE, 7, 189, 286, 18
    AUTOCHECKBOX    "Show the Wi-Fi &icon on the taskbar", IDC_TRAYICON, 7, 214, 160, 10
    PUSHBUTTON      "Close", IDCANCEL, 236, 212, 57, 14
END

IDD_PASS DIALOGEX 0, 0, 230, 104
STYLE DS_MODALFRAME | DS_CENTER | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Connect to a network"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "", IDC_PROMPT, 7, 7, 216, 18
    LTEXT           "&Password:", -1, 7, 30, 40, 8
    EDITTEXT        IDC_PASS, 50, 28, 173, 12, ES_PASSWORD | ES_AUTOHSCROLL
    AUTOCHECKBOX    "&Show characters", IDC_SHOW, 50, 44, 120, 10
    AUTOCHECKBOX    "Connect &automatically when in range", IDC_AUTO, 50, 56, 170, 10
    AUTOCHECKBOX    "Allow older &WPA (TKIP, less secure)", IDC_TKIP, 50, 68, 170, 10
    DEFPUSHBUTTON   "OK", IDOK, 119, 84, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 173, 84, 50, 14
END

IDD_ADD DIALOGEX 0, 0, 230, 134
STYLE DS_MODALFRAME | DS_CENTER | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Other network"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "For a network that does not show its name, or one that is not in range now.", -1, 7, 7, 216, 18
    LTEXT           "&Name:", -1, 7, 30, 40, 8
    EDITTEXT        IDC_SSID, 50, 28, 173, 12, ES_AUTOHSCROLL
    LTEXT           "Se&curity:", -1, 7, 47, 40, 8
    COMBOBOX        IDC_SECURITY, 50, 45, 173, 40, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "&Password:", -1, 7, 64, 40, 8
    EDITTEXT        IDC_PASS, 50, 62, 173, 12, ES_PASSWORD | ES_AUTOHSCROLL
    AUTOCHECKBOX    "&Show characters", IDC_SHOW, 50, 78, 120, 10
    AUTOCHECKBOX    "Connect &automatically when in range", IDC_AUTO, 50, 90, 170, 10
    DEFPUSHBUTTON   "OK", IDOK, 119, 112, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 173, 112, 50, 14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "KernelExEx"
            VALUE "FileDescription", "KernelExEx Wi-Fi"
            VALUE "FileVersion", KEXEX_VERSION_STR
            VALUE "LegalCopyright", "GPL version 2"
            VALUE "ProductName", "KernelExEx"
            VALUE "ProductVersion", KEXEX_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
