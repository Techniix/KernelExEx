/* KernelExEx - kexpower.cpl resources. GPLv2. */
#include <windows.h>
#include "resource.h"
#include "version.h"

IDI_POWER ICON "kexpower.ico"

STRINGTABLE
BEGIN
    1 "Battery"
    2 "The laptop battery: charge, time left, warnings and what closing the lid does."
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "KernelExEx"
            VALUE "FileDescription", "KernelExEx Battery Control Panel"
            VALUE "FileVersion", KEXEX_VERSION_STR
            VALUE "ProductName", "KernelExEx"
            VALUE "ProductVersion", KEXEX_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
