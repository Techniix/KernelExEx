#include <windows.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "KernelExEx"
            VALUE "FileDescription", "KernelExEx mouse integration for QEMU and VMware"
            VALUE "FileVersion", KEXEX_VERSION_STR
            VALUE "LegalCopyright", "GPL version 2"
            VALUE "ProductName", "KernelExEx"
            VALUE "ProductVersion", KEXEX_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
