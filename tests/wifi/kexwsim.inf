; kexwsim.inf - KernelExEx simulated Wi-Fi adapter (tests only, on QEMU's
; "-device usb-serial", 0403:6001). Never shipped in setup.

[Version]
Signature="$CHICAGO$"
Class=Net
ClassGUID={4d36e972-e325-11ce-bfc1-08002be10318}
Provider=%KEX%

[Manufacturer]
%KEX%=Models

[Models]
%WSIM%=wsim.ndi,USB\VID_0403&PID_6001

[wsim.ndi]
AddReg=wsim.id,wsim.reg
CopyFiles=wsim.copy
DeviceID=USB\VID_0403&PID_6001
MaxInstance=1

[wsim.id]
HKR,Ndi,DeviceID,,"USB\VID_0403&PID_6001"
HKR,Ndi,MaxInstance,,1

[wsim.reg]
HKR,,DevLoader,,"*ndis"
HKR,,DeviceVxDs,,kexwsim.sys
HKR,,EnumPropPages,,"netdi.dll,EnumPropPages"
HKR,NDIS,LogDriverName,,kexwsim
HKR,NDIS,MajorNdisVersion,1,05
HKR,NDIS,MinorNdisVersion,1,00
HKR,Ndi,HelpText,,%WSIM%
HKR,Ndi\Interfaces,DefUpper,,"ndis3"
HKR,Ndi\Interfaces,DefLower,,"ethernet"
HKR,Ndi\Interfaces,UpperRange,,"ndis3"
HKR,Ndi\Interfaces,LowerRange,,"ethernet"
HKR,Ndi\Install,ndis3,,wsim.ndis3

[wsim.ndis3]

[wsim.copy]
kexwsim.sys
kexbsd.sys

[DestinationDirs]
wsim.copy=11

[SourceDisksNames]
1=%DISK%,,

[SourceDisksFiles]
kexwsim.sys=1
kexbsd.sys=1

[Strings]
KEX="KernelExEx"
WSIM="Simulated Wi-Fi adapter (KernelExEx test)"
DISK="KernelExEx test drivers"
