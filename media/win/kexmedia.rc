/* KernelExEx - kexmedia.exe resources. GPLv2. */
#include <winresrc.h>
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "kexmedia.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "KernelExEx contributors"
      VALUE "FileDescription", "KernelExEx Windows 98 install stick maker"
      VALUE "FileVersion", "1.0"
      VALUE "LegalCopyright", "GPLv2"
      VALUE "ProductName", "KernelExEx"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
