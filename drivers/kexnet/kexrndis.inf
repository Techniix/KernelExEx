; kexrndis.inf - KernelExEx USB RNDIS network adapters (OpenBSD urndis) for Windows 98 SE / ME
; Android phone USB tethering and RNDIS Ethernet gadgets.

[Version]
Signature="$CHICAGO$"
Class=Net
ClassGUID={4d36e972-e325-11ce-bfc1-08002be10318}
Provider=%KEX%

[Manufacturer]
%KEX%=Models

[Models]
%dev0%=rndis0.ndi,USB\VID_0525&PID_A4A2
%dev1%=rndis1.ndi,USB\VID_18D1&PID_4EE3
%dev2%=rndis2.ndi,USB\VID_18D1&PID_4EE4
%dev3%=rndis3.ndi,USB\VID_04E8&PID_6863
%dev4%=rndis4.ndi,USB\VID_04E8&PID_6864
