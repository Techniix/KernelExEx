%dev7%=rndis7.ndi,USB\VID_2717&PID_FF88
%dev8%=rndis8.ndi,USB\Class_E0&SubClass_01&Prot_03
%dev9%=rndis9.ndi,USB\Class_02&SubClass_02&Prot_FF

[rndis0.ndi]
AddReg=rndis0.id,kexrndis.reg
CopyFiles=kexrndis.copy
DeviceID=USB\VID_0525&PID_A4A2
MaxInstance=8

[rndis0.id]
HKR,Ndi,DeviceID,,"USB\VID_0525&PID_A4A2"
HKR,Ndi,MaxInstance,,8

