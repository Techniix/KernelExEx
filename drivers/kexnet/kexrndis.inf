[kexrndis.reg]
HKR,,DevLoader,,"*ndis"
HKR,,DeviceVxDs,,kexrndis.sys
HKR,,EnumPropPages,,"netdi.dll,EnumPropPages"
HKR,NDIS,LogDriverName,,kexrndis
HKR,NDIS,MajorNdisVersion,1,05
HKR,NDIS,MinorNdisVersion,1,00
HKR,Ndi,HelpText,,%HELP%
HKR,Ndi\Interfaces,DefUpper,,"ndis3"
HKR,Ndi\Interfaces,DefLower,,"ethernet"
HKR,Ndi\Interfaces,UpperRange,,"ndis3"
HKR,Ndi\Interfaces,LowerRange,,"ethernet"
HKR,Ndi\Install,ndis3,,kexrndis.ndis3

[kexrndis.ndis3]   ; netdi runs this with no source path: the files come from the device section

[kexrndis.copy]
kexrndis.sys
kexbsd.sys

[DestinationDirs]
kexrndis.copy=11

[SourceDisksNames]
1=%DISK%,,

[SourceDisksFiles]
kexrndis.sys=1
kexbsd.sys=1

[Strings]
KEX="KernelExEx"
DISK="KernelExEx drivers"
HELP="USB network adapter using the RNDIS protocol (Android phone tethering), driven by the OpenBSD urndis driver through KernelExEx kexbsd."
