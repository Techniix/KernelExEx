; kexahci.inf - KernelExEx SATA AHCI driver for Windows 98 SE / ME
; SATA controllers in AHCI mode (PCI class 01 06 01): Windows 98 has no driver for them.
[Version]
Signature="$CHICAGO$"
Class=SCSIAdapter
ClassGUID={4D36E97B-E325-11CE-BFC1-08002BE10318}
Provider=%KEX%
DriverVer=11/16/2026, 1.0.0.0

[Manufacturer]
%KEX%=Models

[Models]
%ahci%=KexAhci,PCI\CC_010601
%ich9%=KexAhci,PCI\VEN_8086&DEV_2922
%ich10%=KexAhci,PCI\VEN_8086&DEV_3A22

[KexAhci]
CopyFiles=KexAhci.CopyFiles
AddReg=KexAhci.AddReg

[KexAhci.AddReg]
HKR,,DevLoader,,*IOS
HKR,,DontLoadIfConflict,,"Y"
HKR,,PortDriver,,kexahci.mpd

[KexAhci.CopyFiles]
kexahci.mpd

[DestinationDirs]
KexAhci.CopyFiles=12

[SourceDisksNames]
1="KernelExEx SATA AHCI driver",,0

[SourceDisksFiles]
kexahci.mpd=1

[Strings]
KEX="KernelExEx"
ahci="SATA AHCI controller (KernelExEx)"
ich9="Intel ICH9 SATA AHCI controller (KernelExEx)"
ich10="Intel ICH10 SATA AHCI controller (KernelExEx)"
