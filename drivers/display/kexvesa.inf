;
; kexvesa.inf - VESA (VBE 2.0+) display driver for Windows 98/ME, from KernelExEx
; Driver: vmdisp9x by Jaroslav Hensl (JHRobotics), based on Michal Necasek's driver,
; MIT licence. This INF is adapted from vmdisp9x.inf (Copyright 2012-2022 The OS/2
; Museum, 2023-2026 Jaroslav Hensl), MIT licence.
;
; Works with any graphics card whose BIOS has VESA 2.0 or later (Intel HD/GMA, AMD,
; NVIDIA), at the resolutions the card's BIOS offers. No acceleration.

[version]
DriverVer=11/16/2026,4.2026.11.16
Class=DISPLAY
signature="$CHICAGO$"
Provider=%Mfg%

[DestinationDirs]
DefaultDestDir=11
VESA.Copy=11

[SourceDisksNames]
1="KernelExEx display driver",,0

[SourceDisksFiles]
vesamini.drv=1
vesamini.vxd=1

[Manufacturer]
%Mfg%=Mfg.KEX

[Mfg.KEX]
%IntelHD.DeviceDesc%=VESA, PCI\VEN_8086&DEV_0046
%IntelHD.DeviceDesc%=VESA, PCI\VEN_8086&DEV_0042
%IntelSNB.DeviceDesc%=VESA, PCI\VEN_8086&DEV_0106
%IntelSNB.DeviceDesc%=VESA, PCI\VEN_8086&DEV_0116
%IntelSNB.DeviceDesc%=VESA, PCI\VEN_8086&DEV_0126
%IntelSNB.DeviceDesc%=VESA, PCI\VEN_8086&DEV_0102
%VESAPCI.DeviceDesc%=VESA, PCI\CC_0300
%VESAISA.DeviceDesc%=VESA, *PNP0900

[VESA]
CopyFiles=VESA.Copy
DelReg=KEX.DelReg
AddReg=VESA.AddReg,KEX.AddReg

[VESA.Copy]
vesamini.drv,,,0x00000004
vesamini.vxd,,,0x00000004

[VESA.AddReg]
HKR,DEFAULT,drv,,vesamini.drv
HKR,DEFAULT,minivdd,,vesamini.vxd
HKR,DEFAULT,Mode,,"16,800,600"

[KEX.DelReg]
HKR,,Ver
HKR,,DevLoader
HKR,DEFAULT
HKR,MODES
HKR,CURRENT

[KEX.AddReg]
